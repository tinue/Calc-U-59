#!/usr/bin/env bash
# Run the Screenshots test plan on each simulator.
#
# Each test writes "Diagnostic-<DeviceName>.png" to the Desktop directly.
# Simulators are booted automatically by xcodebuild if they are Shutdown.
#
# Usage:
#   bin/run-screenshots

set -euo pipefail

SRCROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCHEME="Calc-U-59"
TESTPLAN="Screenshots"

# Device name → UDID
declare -A DEVICES=(
    ["iPhone 16e"]="5E58DB4D-147D-4385-A5CF-9974C5321A3B"
    ["iPhone 17 Pro Max"]="9AFA9F97-6BF1-40CE-85D1-1167DF33C9C7"
    ["iPad Pro 13-inch (M5)"]="AA658877-2877-465C-ABB0-ABE7CF4344DE"
    ["iPad mini (A17 Pro)"]="8D4C25D7-8C1E-41F2-9B20-67D7EABB2E57"
)

PASS=0
FAIL=0

for name in "${!DEVICES[@]}"; do
    udid="${DEVICES[$name]}"
    echo "▶ $name ($udid)"

    if xcodebuild test \
        -project "$SRCROOT/Calc-U-59.xcodeproj" \
        -scheme "$SCHEME" \
        -testPlan "$TESTPLAN" \
        -destination "platform=iOS Simulator,id=$udid" \
        2>&1 | grep -E "(Test (Case|Suite)|error:|✓|✗|FAIL|PASS)"; then
        echo "  ✓ $name"
        (( PASS++ )) || true
    else
        echo "  ✗ $name"
        (( FAIL++ )) || true
    fi

    echo
done

echo "Done: $PASS succeeded, $FAIL failed."
