#!/usr/bin/env zsh
# Run the Screenshots test plan on selected simulators.
# Each test writes "Diagnostic-<DeviceName>.png" to the Desktop.
# Add or remove devices by duplicating / deleting the run_test lines.
#
# Usage:
#   bin/run-screenshots

set -euo pipefail

SRCROOT="$(cd "$(dirname "$0")/.." && pwd)"

run_test() {
    local udid="$1"
    echo "▶ $udid"
    xcodebuild test \
        -project "$SRCROOT/Calc-U-59.xcodeproj" \
        -scheme "Calc-U-59" \
        -testPlan "Screenshots" \
        -destination "platform=iOS Simulator,id=$udid"
}

# -- iOS 18.6 --
run_test 5E58DB4D-147D-4385-A5CF-9974C5321A3B   # iPhone 16e

# -- iOS 26.5 --
run_test 9AFA9F97-6BF1-40CE-85D1-1167DF33C9C7   # iPhone 17 Pro Max
run_test AA658877-2877-465C-ABB0-ABE7CF4344DE   # iPad Pro 13-inch (M5)
run_test 8D4C25D7-8C1E-41F2-9B20-67D7EABB2E57   # iPad mini (A17 Pro)
