#!/usr/bin/env zsh
# Capture App Store screenshots on the two target simulators.
#
# Output follows the naming convention required by bin/release-ios --release:
#   iphone-NN-<name>.png   (APP_IPHONE_67,         1320 × 2868 px)
#   ipad-NN-<name>.png     (APP_IPAD_PRO_3GEN_129, 2752 × 2064 px)
#
# The two target simulators are the ones marked `screenshots: iphone` and
# `screenshots: ipad` in bin/simulators.yaml; bin/simulators resolves them to
# UDIDs, so nothing needs rehardcoding after an iOS patch release.
#
# Usage:
#   bin/run-screenshots [filter]
#
# filter: optional substring matched against the full test name, e.g.:
#   "settings"   → iphone-05-settings
#   "05-settings" → iphone-05-settings
#   "02"          → iphone-02-cpu-inspector  ipad-02-calc-debugger

set -euo pipefail

FILTER="${1:-}"
SRCROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCREENSHOT_DIR="$SRCROOT/appstore/screenshots"
echo "$SCREENSHOT_DIR" > /tmp/calc-u-59-screenshot-dir
trap 'rm -f /tmp/calc-u-59-screenshot-dir /tmp/calc-u-59-screenshot-name' EXIT

# ── Test runner ────────────────────────────────────────────────────────────────

run_test() {
    local udid="$1"
    local only="${2:-}"
    local -a extra=()
    [[ -n "$only" ]] && extra+=(-only-testing "Calc-U-59UITests/ScreenshotTests/testScreenshot$only")
    echo "▶ $udid${only:+ ($only)}"
    xcodebuild test \
        -project "$SRCROOT/Calc-U-59.xcodeproj" \
        -scheme "Calc-U-59" \
        -testPlan "Screenshots" \
        -destination "platform=iOS Simulator,id=$udid" \
        "${extra[@]}"
}

# Run a named test only if its name contains $FILTER (or no filter is set).
run_named_test() {
    local name="$1" udid="$2" fn="$3"
    [[ -z "$FILTER" || "$name" == *"$FILTER"* ]] || return 0
    echo "$name" > /tmp/calc-u-59-screenshot-name
    run_test "$udid" "$fn"
}

# ── Resolve simulators ─────────────────────────────────────────────────────────

echo "Resolving simulators…"
IPHONE_UDID=$("$SRCROOT/bin/simulators" resolve --role iphone)
IPAD_UDID=$("$SRCROOT/bin/simulators" resolve --role ipad)
echo "  iphone: $IPHONE_UDID"
echo "  ipad:   $IPAD_UDID"
echo ""

mkdir -p "$SCREENSHOT_DIR"

# ── Run tests ──────────────────────────────────────────────────────────────────
# run_named_test writes the target filename to /tmp before each xcodebuild call;
# the test reads it and names its PNG accordingly.
# iPhone — order here determines the NN sequence numbers.

run_named_test "iphone-01-plain-calculator" "$IPHONE_UDID" PlainCalculator
run_named_test "iphone-02-cpu-inspector"    "$IPHONE_UDID" CPUInspector
run_named_test "iphone-03-calc-debugger"    "$IPHONE_UDID" CalcDebugger
run_named_test "iphone-04-diagnostics"      "$IPHONE_UDID" LoadDiagPreset
run_named_test "iphone-05-settings"         "$IPHONE_UDID" Settings
run_named_test "ipad-01-assembly"           "$IPAD_UDID"   Assembly
run_named_test "ipad-02-calc-debugger"      "$IPAD_UDID"   CalcDebugger
run_named_test "ipad-03-texas"              "$IPAD_UDID"   Texas

echo ""
echo "Screenshots in $SCREENSHOT_DIR:"
ls -1 "$SCREENSHOT_DIR"/*.png(N) 2>/dev/null || echo "  (none)"
