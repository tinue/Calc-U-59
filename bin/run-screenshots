#!/usr/bin/env zsh
# Capture App Store screenshots on the two target simulators.
#
# Output follows the naming convention required by `release ios --release`:
#   iphone-NN-<name>.png   (APP_IPHONE_67,         1320 × 2868 px)
#   ipad-NN-<name>.png     (APP_IPAD_PRO_3GEN_129, 2752 × 2064 px)
#   iphoneduo-NN-<name>.png (iPhone Duo opened flat, 2853 × 2007 px; not yet
#                           uploaded by `release`, whose iphone-* skips it)
#
# The target simulators are the ones marked `screenshots: iphone`, `ipad` and
# `duo` in bin/simulators.yaml; bin/simulators resolves them to
# UDIDs, so nothing needs rehardcoding after an iOS patch release.
#
# Usage:
#   bin/run-screenshots [filter]
#
# filter: optional substring matched against the full test name, e.g.:
#   "settings"   → iphone-05-settings
#   "05-settings" → iphone-05-settings
#   "02"          → iphone-02-cpu-inspector  ipad-02-calc-debugger

set -euo pipefail

FILTER="${1:-}"
SRCROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCREENSHOT_DIR="$SRCROOT/appstore/screenshots"
echo "$SCREENSHOT_DIR" > /tmp/calc-u-59-screenshot-dir
CAPTURE_REQUEST=/tmp/calc-u-59-screenshot-request
CAPTURE_WATCHER=""
stop_capture_watcher() {
    [[ -n "$CAPTURE_WATCHER" ]] || return 0
    pkill -P "$CAPTURE_WATCHER" 2>/dev/null || true
    kill "$CAPTURE_WATCHER" 2>/dev/null || true
    CAPTURE_WATCHER=""
}
trap 'stop_capture_watcher; rm -f /tmp/calc-u-59-screenshot-dir /tmp/calc-u-59-screenshot-name "$CAPTURE_REQUEST"' EXIT

# ── Test runner ────────────────────────────────────────────────────────────────

run_test() {
    local udid="$1"
    local only="${2:-}"
    local -a extra=()
    [[ -n "$only" ]] && extra+=(-only-testing "Calc-U-59UITests/ScreenshotTests/testScreenshot$only")
    echo "▶ $udid${only:+ ($only)}"
    xcodebuild test \
        -project "$SRCROOT/Calc-U-59.xcodeproj" \
        -scheme "Calc-U-59" \
        -testPlan "Screenshots" \
        -destination "platform=iOS Simulator,id=$udid" \
        "${extra[@]}"
}

# "<id> <backlight state>" of the device's largest display.
largest_display() {
    xcrun devicectl device info displays -d "$1" -q -j - 2>/dev/null | python3 -c '
import json, sys
displays = json.load(sys.stdin)["result"]["displays"]
inner = max(displays, key=lambda d: d["nativeSize"][0] * d["nativeSize"][1])
print(inner["displayId"], inner.get("backlightState"))'
}

# App Store Connect accepts no alpha channel; simctl's PNGs have one.
remove_alpha() {
    xcrun swift - "$1" <<'SWIFT'
import CoreGraphics
import Foundation
import ImageIO
let url = URL(fileURLWithPath: CommandLine.arguments[1]) as CFURL
let source = CGImageSourceCreateWithURL(url, nil)!
let image = CGImageSourceCreateImageAtIndex(source, 0, nil)!
let context = CGContext(data: nil, width: image.width, height: image.height,
                        bitsPerComponent: 8, bytesPerRow: 0,
                        space: image.colorSpace ?? CGColorSpaceCreateDeviceRGB(),
                        bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue)!
context.draw(image, in: CGRect(x: 0, y: 0, width: image.width, height: image.height))
let destination = CGImageDestinationCreateWithURL(url, "public.png" as CFString, 1, nil)!
CGImageDestinationAddImage(destination, context.makeImage()!, nil)
exit(CGImageDestinationFinalize(destination) ? 0 : 1)
SWIFT
}

# A landscape test asks for its shot by creating $CAPTURE_REQUEST and holds the
# screen until the file is gone: XCUIScreen's landscape shots are portrait
# pixels with a rotation tag, and on the open Duo a pixel short. If this fails,
# the file stays and the test fails.
capture_on_request() {
    local udid="$1" dest="$2" display
    until [[ -e "$CAPTURE_REQUEST" ]]; do sleep 0.25; done
    display=$(largest_display "$udid")
    xcrun simctl io "$udid" screenshot --display="${display%% *}" "$dest"
    remove_alpha "$dest"
    rm -f "$CAPTURE_REQUEST"
}

# Run a named test only if its name contains $FILTER (or no filter is set).
run_named_test() {
    local name="$1" udid="$2" fn="$3" result=0
    [[ -z "$FILTER" || "$name" == *"$FILTER"* ]] || return 0
    echo "$name" > /tmp/calc-u-59-screenshot-name
    rm -f "$CAPTURE_REQUEST"
    capture_on_request "$udid" "$SCREENSHOT_DIR/$name.png" &
    CAPTURE_WATCHER=$!
    run_test "$udid" "$fn" || result=$?
    stop_capture_watcher
    return $result
}

# ── Resolve simulators ─────────────────────────────────────────────────────────

echo "Resolving simulators…"
IPHONE_UDID=$("$SRCROOT/bin/simulators" resolve --role iphone)
IPAD_UDID=$("$SRCROOT/bin/simulators" resolve --role ipad)
DUO_UDID=$("$SRCROOT/bin/simulators" resolve --role duo)
echo "  iphone: $IPHONE_UDID"
echo "  ipad:   $IPAD_UDID"
echo "  duo:    $DUO_UDID"
echo ""

mkdir -p "$SCREENSHOT_DIR"

# The Duo is shot opened flat; simctl cannot unfold it, so check that the
# inner (larger) display is lit. Its `active` flag won't do: since iOS 27.2 it
# stays on the outer display of an open Duo. Device Hub: hold Option for the
# hinge slider.
duo_is_open() {
    xcrun simctl bootstatus "$DUO_UDID" -b >/dev/null
    local -a display
    display=($(largest_display "$DUO_UDID"))
    [[ "${display[2]:-off}" != off ]]
}

# ── Run tests ──────────────────────────────────────────────────────────────────
# run_named_test writes the target filename to /tmp before each xcodebuild call;
# a portrait test reads it and names its PNG accordingly.
# iPhone — order here determines the NN sequence numbers.

run_named_test "iphone-01-plain-calculator" "$IPHONE_UDID" PlainCalculator
run_named_test "iphone-02-cpu-inspector"    "$IPHONE_UDID" CPUInspector
run_named_test "iphone-03-calc-debugger"    "$IPHONE_UDID" CalcDebugger
run_named_test "iphone-04-diagnostics"      "$IPHONE_UDID" LoadDiagPreset
run_named_test "iphone-05-settings"         "$IPHONE_UDID" Settings
run_named_test "ipad-01-assembly"           "$IPAD_UDID"   Assembly
run_named_test "ipad-02-calc-debugger"      "$IPAD_UDID"   CalcDebugger
run_named_test "ipad-03-texas"              "$IPAD_UDID"   Texas
if [[ -z "$FILTER" || "iphoneduo-03-calc-debugger" == *"$FILTER"* ]]; then
    if duo_is_open; then
        run_named_test "iphoneduo-03-calc-debugger" "$DUO_UDID" CalcDebugger
    else
        echo "⚠ iPhone Duo is folded — open it flat in Device Hub, then: bin/run-screenshots iphoneduo"
    fi
fi

echo ""
echo "Screenshots in $SCREENSHOT_DIR:"
ls -1 "$SCREENSHOT_DIR"/*.png(N) 2>/dev/null || echo "  (none)"
