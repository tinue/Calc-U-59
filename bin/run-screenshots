#!/usr/bin/env zsh
# Capture App Store screenshots on the two target simulators.
#
# Output follows the naming convention required by bin/release-ios --release:
#   iphone-NN-<name>.png   (APP_IPHONE_67,         1320 × 2868 px)
#   ipad-NN-<name>.png     (APP_IPAD_PRO_3GEN_129, 2752 × 2064 px)
#
# Simulator UDIDs are resolved dynamically — no hardcoding needed after
# recreating simulators for a new iOS patch release.
#
# Usage:
#   bin/run-screenshots

set -euo pipefail

SRCROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCREENSHOT_DIR="$SRCROOT/appstore/screenshots"
echo "$SCREENSHOT_DIR" > /tmp/calc-u-59-screenshot-dir
trap 'rm -f /tmp/calc-u-59-screenshot-dir /tmp/calc-u-59-screenshot-name' EXIT

# ── Simulator lookup ───────────────────────────────────────────────────────────
# Returns the UDID of the latest available iOS simulator matching the given name.

find_simulator() {
    local name="$1"
    local udid
    udid=$(python3 -c "
import json, subprocess, sys
out = subprocess.check_output(['xcrun', 'simctl', 'list', 'devices', 'available', '--json'])
data = json.loads(out)
for rt in sorted(data['devices'], reverse=True):
    if 'iOS' not in rt: continue
    for d in data['devices'][rt]:
        if d['name'] == sys.argv[1]:
            print(d['udid'])
            sys.exit(0)
" "$name" 2>/dev/null)
    if [[ -z "$udid" ]]; then
        print -u2 "Error: no available simulator named '$name'."
        print -u2 "  Create it in Xcode → Window → Devices and Simulators."
        return 1
    fi
    echo "$udid"
}

# ── Test runner ────────────────────────────────────────────────────────────────

run_test() {
    local udid="$1"
    local only="${2:-}"
    local -a extra=()
    [[ -n "$only" ]] && extra+=(-only-testing "Calc-U-59UITests/ScreenshotTests/testScreenshot$only")
    echo "▶ $udid${only:+ ($only)}"
    xcodebuild test \
        -project "$SRCROOT/Calc-U-59.xcodeproj" \
        -scheme "Calc-U-59" \
        -testPlan "Screenshots" \
        -destination "platform=iOS Simulator,id=$udid" \
        "${extra[@]}"
}

# ── Resolve simulators ─────────────────────────────────────────────────────────

echo "Resolving simulators…"
IPHONE_UDID=$(find_simulator "iPhone 17 Pro Max")
IPAD_UDID=$(find_simulator "iPad Pro 13-inch (M5)")
echo "  iPhone 17 Pro Max:       $IPHONE_UDID"
echo "  iPad Pro 13-inch (M5):   $IPAD_UDID"
echo ""

mkdir -p "$SCREENSHOT_DIR"

# ── Run tests ──────────────────────────────────────────────────────────────────
# The desired output filename is written to /tmp/calc-u-59-screenshot-name before
# each xcodebuild call; the test reads it and names its PNG accordingly.
# iPhone — order here determines the NN sequence numbers.

echo "iphone-01-plain-calculator" > /tmp/calc-u-59-screenshot-name
run_test "$IPHONE_UDID" PlainCalculator   # cover picture, plain calculator with filled display

echo "iphone-02-cpu-inspector" > /tmp/calc-u-59-screenshot-name
run_test "$IPHONE_UDID" CPUInspector      # CPU debugger frozen in the Reset routine

echo "iphone-03-calc-debugger" > /tmp/calc-u-59-screenshot-name
run_test "$IPHONE_UDID" CalcDebugger      # calculator debugger frozen at SBR = location

echo "iphone-04-diagnostics" > /tmp/calc-u-59-screenshot-name
run_test "$IPHONE_UDID" LoadDiagPreset    # diagnostics with card inlay (was iPhone 16e)

echo "iphone-05-settings" > /tmp/calc-u-59-screenshot-name
run_test "$IPHONE_UDID" Settings          # settings panel (was iPhone 16e)

# iPad
echo "ipad-01-assembly" > /tmp/calc-u-59-screenshot-name
run_test "$IPAD_UDID" Assembly            # ASM overlay with stopwatch running

echo "ipad-02-calc-debugger" > /tmp/calc-u-59-screenshot-name
run_test "$IPAD_UDID" CalcDebugger        # calculator debugger with printer output

echo ""
echo "Screenshots in $SCREENSHOT_DIR:"
ls -1 "$SCREENSHOT_DIR"/*.png(N) 2>/dev/null || echo "  (none)"
