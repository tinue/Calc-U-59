#!/usr/bin/env zsh
# Run the Screenshots test plan on selected simulators.
# Each test writes its PNG to SCREENSHOT_DIR.
# Add or remove devices by duplicating / deleting the run_test lines.
#
# Usage:
#   bin/run-screenshots
#
# run_test <udid> [only-testing]
#   udid         — simulator UDID
#   only-testing — optional test name suffix (after "testScreenshot")

set -euo pipefail

SRCROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCREENSHOT_DIR="$SRCROOT/appstore/screenshots"

run_test() {
    local udid="$1"
    local only="${2:-}"
    local -a extra=()
    [[ -n "$only" ]] && extra+=(-only-testing "Calc-U-59UITests/ScreenshotTests/testScreenshot$only")
    extra+=(-testenv "SCREENSHOT_DIR=$SCREENSHOT_DIR")
    echo "▶ $udid${only:+ ($only)}"
    xcodebuild test \
        -project "$SRCROOT/Calc-U-59.xcodeproj" \
        -scheme "Calc-U-59" \
        -testPlan "Screenshots" \
        -destination "platform=iOS Simulator,id=$udid" \
        "${extra[@]}"
}

echo "Available Devices:"
xcrun simctl list devices available | awk '
    /^-- / { section=$0; next }
    /\(/ { if (section) { print section; section="" } print }
'
echo ""

mkdir -p "$SCREENSHOT_DIR"

# -- iOS 18.6 --
run_test 5E58DB4D-147D-4385-A5CF-9974C5321A3B LoadDiagPreset   # iPhone 16e

# -- iOS 26.5 --
run_test 9AFA9F97-6BF1-40CE-85D1-1167DF33C9C7 LoadDiagPreset   # iPhone 17 Pro Max
run_test AA658877-2877-465C-ABB0-ABE7CF4344DE LoadDiagPreset   # iPad Pro 13-inch (M5)
run_test 8D4C25D7-8C1E-41F2-9B20-67D7EABB2E57 LoadDiagPreset   # iPad mini (A17 Pro)

# -- CalcDebuggeriPad — iPad Pro 13-inch (M5) only --
run_test AA658877-2877-465C-ABB0-ABE7CF4344DE CalcDebuggeriPad
