#!/usr/bin/env bash
# Copy all example files (state files, assembly) into the booted simulator's app Documents folder.
# Markdown files and .DS_Store are excluded; everything else under examples/ is copied flat.
#
# Run once after installing the app on the simulator, and again whenever examples/
# files change.  Also suitable as a scheme pre-action:
#   Shell: /bin/bash
#   Script: $SRCROOT/bin/setup-simulator-state-files
#   Provide build settings from: Calc-U-59 (the app target)
#
# The script exits 0 even when the container does not exist yet (first-ever run).
# In that case, launch the app once manually (or let AppStoreScreenshots.setUp do it),
# then re-run this script before executing the screenshot tests.

set -euo pipefail

BUNDLE_ID="ch.erzberger.calcu59"
SRCROOT="${SRCROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

CONTAINER=$(xcrun simctl get_app_container booted "$BUNDLE_ID" data 2>/dev/null || true)
if [ -z "$CONTAINER" ]; then
    echo "warning: app container not found for $BUNDLE_ID on booted simulator." >&2
    echo "  Launch the app once, then re-run this script." >&2
    exit 0
fi

DOCS="$CONTAINER/Documents"
mkdir -p "$DOCS"

COUNT=0
while IFS= read -r -d '' SRC; do
    FILE=$(basename "$SRC")
    cp "$SRC" "$DOCS/$FILE"
    echo "Copied $FILE"
    (( COUNT++ )) || true
done < <(find "$SRCROOT/examples" -type f ! -name "*.md" ! -name ".DS_Store" -print0 | sort -z)

echo "$COUNT file(s) copied to $DOCS"
