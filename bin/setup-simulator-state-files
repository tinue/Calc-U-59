#!/usr/bin/env bash
# Copy selected example files into every simulator's local file provider storage,
# where they appear under "On My iPad/iPhone → Calc-U-59" in the file picker.
# Files are copied flat; the destination is cleaned first for a reproducible state.
#
# Targets all installed simulators — no simulator needs to be running.
# Files go to group.com.apple.FileProvider.LocalStorage / File Provider Storage/
# in each device that has that group initialised.  The group UUID varies per
# simulator, so it is found by reading each AppGroup's metadata plist.
#
# Also suitable as a scheme pre-action (no build settings expansion needed):
#   Shell: /bin/bash
#   Script: $SRCROOT/bin/setup-simulator-state-files

set -euo pipefail

LOCAL_STORAGE_GROUP="group.com.apple.FileProvider.LocalStorage"
SRCROOT="${SRCROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
SIM_ROOT="$HOME/Library/Developer/CoreSimulator/Devices"

# Files to install — paths relative to examples/, globs are expanded at runtime.
FILE_PATTERNS=(
    "debug/screenshot_leisure_run.ti59"
    "debug/screenshot_leisure_start.ti59"
    "assembly/stopwatch.asm"
    "characters-fastmode.ti59"
    "characters.ti59"
    "diag.*"
)

# Expand patterns to absolute paths (bash 3.2 compatible — no mapfile).
SRCS=()
for pattern in "${FILE_PATTERNS[@]}"; do
    for f in "$SRCROOT/examples/"$pattern; do
        [ -f "$f" ] && SRCS+=("$f")
    done
done

if [ ${#SRCS[@]} -eq 0 ]; then
    echo "No matching files found under $SRCROOT/examples — nothing to copy." >&2
    exit 0
fi

DEST_COUNT=0

while IFS= read -r -d '' META; do
    # Skip orphaned device directories (no device.plist — simctl doesn't know them).
    uuid="${META#$SIM_ROOT/}"; uuid="${uuid%%/*}"
    [ -f "$SIM_ROOT/$uuid/device.plist" ] || continue

    if plutil -p "$META" 2>/dev/null | grep -q "\"$LOCAL_STORAGE_GROUP\""; then
        DEST="$(dirname "$META")/File Provider Storage"
        mkdir -p "$DEST"
        find "$DEST" -maxdepth 1 -type f -delete
        for SRC in "${SRCS[@]}"; do
            cp "$SRC" "$DEST/$(basename "$SRC")"
        done
        echo "Copied ${#SRCS[@]} file(s) → $DEST"
        (( DEST_COUNT++ )) || true
    fi
done < <(find "$SIM_ROOT" -maxdepth 7 -name ".com.apple.mobile_container_manager.metadata.plist" -print0 2>/dev/null)

if [ "$DEST_COUNT" -eq 0 ]; then
    echo "No '$LOCAL_STORAGE_GROUP' AppGroup found in any simulator." >&2
    echo "  Open the Files app or file picker in a simulator once, then re-run." >&2
    exit 0
fi

echo "Done — $DEST_COUNT simulator(s) updated."
