#!/usr/bin/env python3
"""
Delete simulator devices not listed in bin/simulators.yaml (on their resolved runtime),
plus all unavailable runtimes, plus any UUID directories left behind in
CoreSimulator/Devices that simctl no longer tracks (orphans).

Usage:
    bin/trim-simulators            # dry run — shows what would be deleted
    bin/trim-simulators --delete   # actually delete

Edit bin/simulators.yaml to adjust the device list.
A device is kept only on the latest available patch of its configured iOS major version.
"""

import json
import re
import subprocess
import sys
from pathlib import Path


CONFIG = Path(__file__).parent / "simulators.yaml"
DEVICES_DIR = Path.home() / "Library/Developer/CoreSimulator/Devices"
UUID_RE = re.compile(r"^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$", re.I)


def load_simulators(path: Path) -> list[dict]:
    devs: list[dict] = []
    cur: dict | None = None
    for line in path.read_text().splitlines():
        if re.match(r"^- ", line):
            if cur is not None:
                devs.append(cur)
            cur = {}
        # parse key: value from both "- key: val" and "  key: val" lines
        m = re.match(r"^[-\s]\s*(\w+):\s*(.*)", line)
        if m and cur is not None:
            k, v = m.group(1), m.group(2).strip()
            cur[k] = int(v) if v.isdigit() else (v or None)
    if cur is not None:
        devs.append(cur)
    return devs


def latest_runtime_for_major(major: int, runtimes: list[dict]) -> str | None:
    """Return the identifier of the latest available runtime for the given iOS major."""
    candidates = []
    for r in runtimes:
        if not r.get("isAvailable", False):
            continue
        suffix = r["identifier"].split("iOS-", 1)
        if len(suffix) < 2:
            continue
        if suffix[1].split("-")[0] != str(major):
            continue
        candidates.append(r)
    candidates.sort(key=lambda r: [int(x) for x in r["version"].split(".")], reverse=True)
    return candidates[0]["identifier"] if candidates else None


def runtime_display(runtime_id: str) -> str:
    """com.apple.CoreSimulator.SimRuntime.iOS-18-6  →  iOS 18.6"""
    name = runtime_id.replace("com.apple.CoreSimulator.SimRuntime.", "")
    parts = name.split("-")
    for i, part in enumerate(parts):
        if part.isdigit():
            platform = "-".join(parts[:i])
            version  = ".".join(parts[i:])
            return f"{platform} {version}"
    return name


def main() -> None:
    dry_run = "--delete" not in sys.argv

    config_devices = load_simulators(CONFIG)

    runtimes_raw = subprocess.run(
        ["xcrun", "simctl", "list", "runtimes", "--json"],
        capture_output=True, text=True, check=True,
    )
    runtimes = json.loads(runtimes_raw.stdout)["runtimes"]

    # Build the set of (runtime_id, name) pairs to keep.
    keep_pairs: set[tuple[str, str]] = set()
    for d in config_devices:
        rt = latest_runtime_for_major(d["ios"], runtimes)
        if rt:
            keep_pairs.add((rt, d["name"]))
        else:
            print(
                f"Warning: no iOS {d['ios']}.x runtime available — "
                f"'{d['name']}' will not be protected from deletion.",
                file=sys.stderr,
            )

    result = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "--json"],
        capture_output=True, text=True, check=True,
    )
    devices_by_runtime: dict = json.loads(result.stdout)["devices"]

    to_delete: list[tuple[str, str, str]] = []   # (runtime_display, name, udid)
    keep_udids: set[str] = set()

    for runtime_id, devs in devices_by_runtime.items():
        display = runtime_display(runtime_id)
        for d in devs:
            if (runtime_id, d["name"]) in keep_pairs:
                keep_udids.add(d["udid"])
            else:
                to_delete.append((display, d["name"], d["udid"]))

    # Directories in CoreSimulator/Devices not tracked by simctl at all.
    known_udids = {d["udid"] for devs in devices_by_runtime.values() for d in devs}
    orphan_dirs: list[Path] = [
        p for p in DEVICES_DIR.iterdir()
        if UUID_RE.match(p.name) and p.name not in known_udids
    ]

    label = "DRY RUN — " if dry_run else ""

    if to_delete:
        print(f"{label}{len(to_delete)} simctl device(s) to delete:\n")
        current = None
        for runtime, name, udid in sorted(to_delete):
            if runtime != current:
                print(f"  {runtime}")
                current = runtime
            print(f"    {name}  ({udid})")
    else:
        print("No simctl devices to delete.")

    if orphan_dirs:
        print(f"\n{label}{len(orphan_dirs)} orphaned director{'y' if len(orphan_dirs) == 1 else 'ies'} to remove:")
        for p in sorted(orphan_dirs):
            print(f"  {p.name}")

    if dry_run:
        total = len(to_delete) + len(orphan_dirs)
        if total:
            print(f"\nRun with --delete to remove {total} item(s) and purge unavailable runtimes.")
        return

    if to_delete:
        udids = [udid for _, _, udid in to_delete]
        subprocess.run(["xcrun", "simctl", "delete"] + udids, check=True)

    print("Purging unavailable runtimes...")
    subprocess.run(["xcrun", "simctl", "delete", "unavailable"], check=True)

    if orphan_dirs:
        # Pause the iCloud sync daemon while deleting: simulator directories
        # can contain dataless Mobile Documents stubs that bird holds open.
        subprocess.run(["killall", "bird"], check=False)
        subprocess.run(["sleep", "1"], check=False)
        failed: list[Path] = []
        for p in orphan_dirs:
            result = subprocess.run(["rm", "-rf", str(p)], capture_output=True)
            if result.returncode == 0:
                print(f"Removed orphaned directory: {p.name}")
            else:
                failed.append(p)
        if failed:
            print("\nThe following director(ies) could not be removed automatically")
            print("(iCloud dataless stubs block rm -rf even as the current user).")
            print("Remove them manually with sudo:\n")
            for p in failed:
                print(f"  sudo rm -rf '{p}'")

    print("Done.")


if __name__ == "__main__":
    main()
