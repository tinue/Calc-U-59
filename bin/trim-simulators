#!/usr/bin/env python3
"""
Delete simulator devices not listed in KEEP, plus all unavailable runtimes,
plus any UUID directories left behind in CoreSimulator/Devices that simctl
no longer tracks (orphans).

Usage:
    bin/trim-simulators            # dry run — shows what would be deleted
    bin/trim-simulators --delete   # actually delete

Edit KEEP after an OS upgrade to reflect the versions and devices you want.
A None value for the device list keeps ALL devices for that runtime.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

# ── Edit these after an OS upgrade ──────────────────────────────────────────
KEEP: dict[str, list[str] | None] = {
    "iOS 26.5": [
        "iPad Pro 13-inch (M5)",
        "iPhone 17 Pro Max",
        "iPad mini (A17 Pro)",
    ],
    "iOS 18.6": [
        "iPhone 16e",
    ],
}
# ────────────────────────────────────────────────────────────────────────────

DEVICES_DIR = Path.home() / "Library/Developer/CoreSimulator/Devices"
UUID_RE = re.compile(r"^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$", re.I)


def runtime_display(runtime_id: str) -> str:
    """com.apple.CoreSimulator.SimRuntime.iOS-18-6  →  iOS 18.6"""
    name = runtime_id.replace("com.apple.CoreSimulator.SimRuntime.", "")
    parts = name.split("-")
    for i, part in enumerate(parts):
        if part.isdigit():
            platform = "-".join(parts[:i])
            version  = ".".join(parts[i:])
            return f"{platform} {version}"
    return name


def main() -> None:
    dry_run = "--delete" not in sys.argv

    result = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "--json"],
        capture_output=True, text=True, check=True,
    )
    devices_by_runtime: dict = json.loads(result.stdout)["devices"]

    to_delete: list[tuple[str, str, str]] = []   # (runtime_display, name, udid)
    keep_udids: set[str] = set()

    for runtime_id, devices in devices_by_runtime.items():
        display = runtime_display(runtime_id)
        keep_devices = KEEP.get(display)
        for d in devices:
            if keep_devices is not None and d["name"] in keep_devices:
                keep_udids.add(d["udid"])
            else:
                to_delete.append((display, d["name"], d["udid"]))

    # Directories in CoreSimulator/Devices not tracked by simctl at all.
    known_udids = {d["udid"] for devices in devices_by_runtime.values() for d in devices}
    orphan_dirs: list[Path] = [
        p for p in DEVICES_DIR.iterdir()
        if UUID_RE.match(p.name) and p.name not in known_udids
    ]

    label = "DRY RUN — " if dry_run else ""

    if to_delete:
        print(f"{label}{len(to_delete)} simctl device(s) to delete:\n")
        current = None
        for runtime, name, udid in sorted(to_delete):
            if runtime != current:
                print(f"  {runtime}")
                current = runtime
            print(f"    {name}  ({udid})")
    else:
        print("No simctl devices to delete.")

    if orphan_dirs:
        print(f"\n{label}{len(orphan_dirs)} orphaned director{'y' if len(orphan_dirs) == 1 else 'ies'} to remove:")
        for p in sorted(orphan_dirs):
            print(f"  {p.name}")

    if dry_run:
        total = len(to_delete) + len(orphan_dirs)
        if total:
            print(f"\nRun with --delete to remove {total} item(s) and purge unavailable runtimes.")
        return

    if to_delete:
        udids = [udid for _, _, udid in to_delete]
        subprocess.run(["xcrun", "simctl", "delete"] + udids, check=True)

    print("Purging unavailable runtimes...")
    subprocess.run(["xcrun", "simctl", "delete", "unavailable"], check=True)

    if orphan_dirs:
        # Pause the iCloud sync daemon while deleting: simulator directories
        # can contain dataless Mobile Documents stubs that bird holds open.
        subprocess.run(["killall", "bird"], check=False)
        subprocess.run(["sleep", "1"], check=False)
        failed: list[Path] = []
        for p in orphan_dirs:
            result = subprocess.run(["rm", "-rf", str(p)], capture_output=True)
            if result.returncode == 0:
                print(f"Removed orphaned directory: {p.name}")
            else:
                failed.append(p)
        if failed:
            print("\nThe following director(ies) could not be removed automatically")
            print("(iCloud dataless stubs block rm -rf even as the current user).")
            print("Remove them manually with sudo:\n")
            for p in failed:
                print(f"  sudo rm -rf '{p}'")

    print("Done.")


if __name__ == "__main__":
    main()
