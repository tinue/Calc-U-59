#!/usr/bin/env python3
"""
Delete simulator devices not listed in KEEP, plus all unavailable runtimes.

Usage:
    bin/trim-simulators            # dry run — shows what would be deleted
    bin/trim-simulators --delete   # actually delete

Edit KEEP after an OS upgrade to reflect the versions and devices you want.
A None value for the device list keeps ALL devices for that runtime.
"""

import json
import subprocess
import sys

# ── Edit these after an OS upgrade ──────────────────────────────────────────
KEEP: dict[str, list[str] | None] = {
    "iOS 26.5": [
        "iPad Pro 13-inch (M5)",
        "iPhone 17 Pro Max",
        "iPad mini (A17 Pro)",
    ],
    "iOS 18.6": [
        "iPhone 16e",
    ],
}
# ────────────────────────────────────────────────────────────────────────────


def runtime_display(runtime_id: str) -> str:
    """com.apple.CoreSimulator.SimRuntime.iOS-18-6  →  iOS 18.6"""
    name = runtime_id.replace("com.apple.CoreSimulator.SimRuntime.", "")
    parts = name.split("-")
    for i, part in enumerate(parts):
        if part.isdigit():
            platform = "-".join(parts[:i])
            version  = ".".join(parts[i:])
            return f"{platform} {version}"
    return name


def main() -> None:
    dry_run = "--delete" not in sys.argv

    result = subprocess.run(
        ["xcrun", "simctl", "list", "devices", "--json"],
        capture_output=True, text=True, check=True,
    )
    devices_by_runtime: dict = json.loads(result.stdout)["devices"]

    to_delete: list[tuple[str, str, str]] = []   # (runtime_display, name, udid)

    for runtime_id, devices in devices_by_runtime.items():
        display = runtime_display(runtime_id)
        keep_devices = KEEP.get(display)   # None = not in KEEP at all
        for d in devices:
            if keep_devices is None or d["name"] not in keep_devices:
                to_delete.append((display, d["name"], d["udid"]))

    if not to_delete:
        print("No devices to delete (plus unavailable runtimes will still be purged).")
    else:
        label = "DRY RUN — " if dry_run else ""
        print(f"{label}{len(to_delete)} device(s) to delete:\n")
        current = None
        for runtime, name, udid in sorted(to_delete):
            if runtime != current:
                print(f"  {runtime}")
                current = runtime
            print(f"    {name}  ({udid})")

    if dry_run:
        if to_delete:
            print(f"\nRun with --delete to remove these {len(to_delete)} device(s) and all unavailable runtimes.")
        return

    if to_delete:
        udids = [udid for _, _, udid in to_delete]
        subprocess.run(["xcrun", "simctl", "delete"] + udids, check=True)

    print("Purging unavailable runtimes...")
    subprocess.run(["xcrun", "simctl", "delete", "unavailable"], check=True)
    print("Done.")


if __name__ == "__main__":
    main()
