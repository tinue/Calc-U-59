# fast-grafik-3d-plot.ti59 Program that demonstrates interrupting the printer while printing a row.
# From Magatzine "TI PPC NOTES", V8N2P11ff, 1983
#
# The article itself is in the 1st part of the program.

# Part 1 has run, the machine must not be reset!
SKIP-RESET: true
PARTITION: 639.39

# Prepare the magnet card inlay
CUECARD:
Template: MagnetCard
Title: Fast Grafik 3D Plot - Part 2
Banks: 1,2

# For compactness, the program is only here as key codes. If you need the listing,
# load the program and LIST it on the printer.
