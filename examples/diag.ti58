# diag.ti58 — TI-59 calculator diagnostic magnet card, shrunk to fit TI-58.
#
# After loading, press "E" to start. If ok, the calculator shows "-.8888888888" on the screen, and also prints this number.

# Default partitioning
PARTITION: 239.29   # 240 steps, 30 data registers (default)

# Prepare the cue card inlay
CUECARD:
Template: CueCard
Title: CALCULATOR DIAGNOSTIC - Consult Owner's Manual
Banks: 1
E: EXECUTE

# Print output requires the printer to be active
PRINTER: on

# The programs contains many zeroes, which are skipped below.
PROGRAM:
000  76 LBL
001  12  B
002  85  +
003  04  4
004  95  =
005  34 √X
006  92 RTN
...
