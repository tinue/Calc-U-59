24 36 19 71 00 45 37 31 46 31  81 25 05 69 17 61 00 17 31 68
61 02 65 25 69 05 31 61 04 73  31 53 00 00 00 54 61 02 88 31

# The keystrokes entered will plot something nice. If you want
# your own output, change them here, or delete this section and
# enter the values manually.
KEYSTROKES:
# Launch
11  A
WaitFullSpeed: 0.5s
# X-MAX
72  4
91  R/S
WaitFullSpeed: 0.5s
# X-MIN
72  4
94  +/-
91  R/S
WaitFullSpeed: 0.5s
# Y-MAX
72  4
91  R/S
WaitFullSpeed: 0.5s
# Y-MIN
72  4
94  +/-
91  R/S
WaitFullSpeed: 0.5s
# Z-MAX
82  1
83  2
91  R/S
WaitFullSpeed: 0.5s
# Z-MIN
92  0
91  R/S
WaitFullSpeed: 0.5s
# DIF-X
82  1
91  R/S
WaitFullSpeed: 0.5s
# DIF-Y
82  1
91  R/S
WaitFullSpeed: 0.5s
# ZEILEN
63  8
92  0
91  R/S
WaitFullSpeed: 0.5s
# STREIFEN
