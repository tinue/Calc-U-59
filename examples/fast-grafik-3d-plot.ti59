# The keystrokes entered will plot something nice. If you want
# your own output, change them here, or delete this section and
# enter the values manually.
KEYSTROKES:
# Full speed through every answer: playback waits after each key until the
# program has stopped, and speed returns to regular when the script ends.
FullSpeed:
# Launch
11  A
# X-MAX
72  4
91  R/S
# X-MIN
72  4
94  +/-
91  R/S
# Y-MAX
72  4
91  R/S
# Y-MIN
72  4
94  +/-
91  R/S
# Z-MAX
82  1
83  2
91  R/S
# Z-MIN
92  0
91  R/S
# DIF-X
82  1
91  R/S
# DIF-Y
82  1
91  R/S
# ZEILEN
63  8
92  0
91  R/S
# STREIFEN
82  1
91  R/S
# X-Y-WINKEL
74  6
73  5
91  R/S
# VERDECKT
82  1
91 R/S

# ── Part 2 ──────────────────────────────────────────────────────────────────
# Everything below follows part 1's KEYSTROKES, so it is a reload: once part 1
# has stopped, part 2 replaces the program and the cue card as if its cards
# had been read. Part 1's registers stay; part 2 needs them.
PARTITION: 639.39

# Prepare the magnet card inlay
CUECARD:
Template: MagnetCard
Title: Fast Grafik 3D Plot - Part 2
Banks: 1,2

