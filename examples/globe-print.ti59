KEYSTROKES:
43          # RCL
92          # 0
92          # 0      X = 1.000000000048
61          # GTO
92          # 0
82          # 1
83          # 2      → step 012
41          # SST    St flg executes, operand pending
92          # 0      first operand digit
42          # STO    ends it: Prg Src 8, run stops at 007
31          # LRN    008, buffer loaded from ROM row 17
21 41       # Ins    008 := 1F, 009 := RTN
31          # LRN
25          # CLR
81          # RST    Prg Src 0
61          # GTO
92          # 0
82          # 1
62          # 7      → step 017
ZeroElapseTime:
FullSpeed:
91          # R/S    print the picture
# Part 2: 3 in the display, read the next card
InsertCard: mem:Part2-Bank3
25          # CLR
InsertCard: mem:Part2-Bank4
91          # R/S    print part 2
# Part 3: 3 in the display, read the next card
InsertCard: mem:Part3-Bank3
25          # CLR
InsertCard: mem:Part3-Bank4
91          # R/S    print part 3
ReportElapseTime:   # the print, card reads included

