# Integer-Base-Conversion.ti59 — Converts from one base to another
# From: https://www.hpmuseum.org/forum/thread-25085.html
# Original from: Computer Design, v19 i5 1980, pages 202, 205, 207
#
# For example, convert 0x2A0 to Binary:
# - 21000 A
# - 16 B
# -  2 C
# -> Result: 1010100000
# - Press R/S to get the decimal value
# -> Result: 672


# Prepare the magnet card inlay
CUECARD:
Template: MagnetCard
Title: Base Conversion
Banks: 1
A: From
B: From: Base
C: To: Base

PROGRAM:
000  76 LBL   
001  11  A    
002  32 X⇄T   
003  91 R/S   
