KEYSTROKES:
FullSpeed:
InsertCard: mem:S11
81                   # RST
91                   # R/S: shows -999.-03
21 81 62             # St flg 7: generation
ArmCard: mem:S999
91                   # 3 INV Write; shows -998.-03
ArmCard: mem:S998
91                   # 2 INV Write; shows -1. 00
21 81 63             # St flg 8: new card -1
91                   # prints 30 STO
91 91 91 91 91 91 91 # 33-39 STO
91 91 91 91 91       # 3-7 HIR
93 92 82 83 91       # HIR 7 = .012; prints 0 FLAG
91 91 91 91 91 91    # 1-6 FLAG
91                   # 7 DATA
91                   # DATA AREA NOT EMPTY, shows 0.1
91                   # shows -1. 00
ArmCard: mem:D-1
91                   # 4 Write; shows 0. 00
21 81 63             # St flg 8: new data card 0
91                   # prints O.K, shows 12.-03
ArmCard: mem:S12
91                   # 1 INV Write: the demo strip is in
RegularSpeed:

11                   # A: C-memory 20 goes to card 0. Shows 0. 00 to write
ArmCard: mem:D0
91                   # shows 1. 00
21 81 63 91          # new card 1; C-memory 40. Shows 1. 00 to write
ArmCard: mem:D1
91                   # shows 2. 00
21 81 63 91          # new card 2; C-memory 60, CGTO: shows 13.-03
ArmCard: mem:S13
91                   # strip 13: prints 20. Shows 2. 00 to write
ArmCard: mem:D2
91                   # shows 0. 00
ArmCard: mem:D0
91                   # prints 400 and 40. Shows 0. 00 to write
ArmCard: mem:D0
91                   # shows 1. 00
ArmCard: mem:D1
91                   # prints 1600 and 60. Shows 1. 00 to write
ArmCard: mem:D1
91                   # shows 2. 00
ArmCard: mem:D2
91                   # prints 3600; CSBR: shows 12.-03
ArmCard: mem:S12
91                   # prints 3 DONE; back: shows 13.-03
ArmCard: mem:S13
91                   # shutdown: shows 1.-03
ArmCard: mem:S1
91                   # shows 2. 00 to write
ArmCard: mem:D2
91                   # shows -2. 00
21 81 63 91          # new card -2; shows -2. 00 to write
ArmCard: mem:D-2
91                   # prints GOOD-BYE FROM PDCM, shows 1.1
