# picard.ti59
#
# Written by ti59-printer-art. A picture printed with the printer
# interrupt, 2 dot rows per line (Calc-U-59 rom/printerinterrupt.md).
# printer-art: orientation ccw
# 23 lines, 68 chunks.
# Part 1: 68 chunks in R03-R70, end address in R71 (the load).
#
# On a real TI-59, before the hack below:
#
#   - 10 2nd Op 17                   partition 159.99, before keying in
#   - key in the program and the registers (part 1)
#   - save it to cards: 1, 2, 3, 4 2nd Write
#                                    two cards, both sides each: banks 1-4
#
# In the preset, everything runs automatically. By hand you need to:
#
#   RCL 00  GTO 012  SST  0  STO     fast-mode hack: Prg Src := 8
#   LRN  2nd Ins  LRN                step 008 becomes 1F, 009 RTN
#   CLR  RST
#   GTO 017  R/S                      print the picture

MODEL: TI-59
PRINTER: on
PARTITION: 159.99

PROGRAM:
000  92  INV SBR   # the interrupt continues here: return to 009
001  00  0
002  00  0
003  76  Lbl
004  11  A         # A: print the line, interrupted
005  00  0         # display must be 0
006  69  Op
007  05  05        # start printing the line …
008  23  lnx       # … becomes 1F: the interrupt
009  53  (         # becomes 92 RTN
010  00  0
011  00  0
012  86  St flg    # hack trigger (overwritten by the Ins)
013  00  0         # swallowed by the hack
014  00  0         # makes X displayable before the R/S
015  91  R/S       # stops the hack's run (moves to 016)
# From here on, each step moves up one during the Ins: 016 runs as 017.
016  69  Op
017  00  00        # clear the print buffer
018  02  2
019  42  STO
020  01  01        # pointer before the first chunk
021  69  Op
022  21  21        # next chunk
023  73  RC*
024  01  01
025  42  STO
026  02  02
027  83  GO*
028  02  02        # to its routine
029  71  SBR
030  11  A         # print the line
031  69  Op
032  00  00        # clear the print buffer
033  61  GTO
034  00  00  # → loop (022)
035  22  22
099  82  HIR
100  05  05        # into chunk 1
101  61  GTO
102  00  00  # → loop (022)
103  22  22
104  82  HIR
105  06  06        # into chunk 2
106  61  GTO
107  00  00  # → loop (022)
108  22  22
109  82  HIR
110  07  07        # into chunk 3
111  61  GTO
112  00  00  # → loop (022)
113  22  22
114  82  HIR
115  08  08        # into chunk 4
116  61  GTO
117  00  00  # → loop (022)
118  22  22
119  82  HIR
120  05  05        # into chunk 1, last of the line
121  61  GTO
122  00  00  # → line (030)
123  30  30
124  82  HIR
125  06  06        # into chunk 2, last of the line
126  61  GTO
127  00  00  # → line (030)
128  30  30
129  82  HIR
130  07  07        # into chunk 3, last of the line
131  61  GTO
132  00  00  # → line (030)
133  30  30
134  82  HIR
135  08  08        # into chunk 4, last of the line
136  61  GTO
137  00  00  # → line (030)
138  30  30
139  91  R/S       # end of the picture
140  03  3         # end of a part: read banks 3 and 4 of the next card
141  91  R/S
142  61  GTO
143  00  00  # → start (017)
144  17  17

