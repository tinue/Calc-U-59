11 07 04 00 00 05 03 07 04 07 04 69 03 02 05 69 04 58 09 07 04 07 04 69 02 07 06 07 06 07 06 07 06 07 69 01 11 00 69 04 04 07 58 08 69 01 07 04 00 00 02 05 07 04 07 04 69 03 75 11 05 03 69 01 02 07 58 02
